# Set the correct Content-Type for each font file type individually
# to ensure they are loaded and parsed correctly by all browsers.

/style/*.woff2
  Content-Type: font/woff2
  Access-Control-Allow-Origin: *

/style/*.woff
  Content-Type: font/woff
  Access-Control-Allow-Origin: *

/style/*.otf
  Content-Type: font/otf
  Access-Control-Allow-Origin: *

